gate: READINGS_WINDOW-CHECK
manifest_version: 2
owner: readings-window
requires:
  - host
inputs:
  - Cargo.toml
  - Cargo.lock
  - src/
  - crates/
  - tests/
  - tests/gates/
  - src/
  - scripts/
run:
  exec: tests/gates/run.sh
  args: ["check"]
expects:
  exit: 0
  verdict: PASS
timeout: 20m
exactness: EXACT
cache_scope: machine
